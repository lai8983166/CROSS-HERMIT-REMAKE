+/*
+ * Project-local TCG execution-loop payload, for same-build checkpoints.
+ * Preserve raw values even while exception_index is inactive: their validity
+ * is interpreted by the execution loop, not by dropping or clearing fields.
+ * The existing cpu/error_code subsection and CPU main layout stay unchanged.
+ */
+static bool terminal_tcg_event_context_needed(void *opaque)
+{
+    return tcg_enabled();
+}
