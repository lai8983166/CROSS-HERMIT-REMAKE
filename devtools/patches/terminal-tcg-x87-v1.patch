+/* Modern x87 tag loads distinguish only empty/nonempty.  Classify the
+ * physical 80-bit payload when exporting the full architectural tag word.
+ * Intel SDM Vol. 1, x87 FPU Tag Word; Vol. 3, Architecture Compatibility.
+ */
+static inline uint16_t cpu_x86_fptag(const CPUX86State *env)
+{
+    uint16_t tag = 0;
+
+    for (int i = 0; i < 8; i++) {
+        uint64_t mant = env->fpregs[i].d.low;
+        unsigned exp = env->fpregs[i].d.high & 0x7fff;
+        unsigned value;
+
+        if (env->fptags[i]) {
+            value = 3;
+        } else if (exp == 0 && mant == 0) {
+            value = 1;
+        } else if (exp == 0 || exp == 0x7fff || !(mant >> 63)) {
+            value = 2;
+        } else {
+            value = 0;
+        }
+        tag |= value << (2 * i);
+    }
+    return tag;
+}
