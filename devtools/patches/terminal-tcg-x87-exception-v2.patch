diff --git a/target/i386/tcg/fpu_helper.c b/target/i386/tcg/fpu_helper.c
--- a/target/i386/tcg/fpu_helper.c
+++ b/target/i386/tcg/fpu_helper.c
@@ -655,6 +655,80 @@
 
     p = &ST(st_index);
     *p = helper_fdiv(env, ST0, *p);
+}
+
+/* Register FDIV/FDIVR/FDIVP/FDIVRP only.  Bit 0 reverses the
+ * operands, bit 1 requests a pop.  Keep both the destination and TOP
+ * untouched for an unmasked pre-computation exception (#I, #Z, #D).
+ * Do not apply this rule to post-computation #O/#U/#P: those have
+ * different result rules (Intel SDM Vol. 1, 4.9.2 and 8.5).
+ */
+void helper_fdiv_reg(CPUX86State *env, int dst_index, int src_index,
+                     uint32_t op)
+{
+    int dst = (env->fpstt + dst_index) & 7;
+    int src = (env->fpstt + src_index) & 7;
+    floatx80 a = env->fpregs[dst].d;
+    floatx80 b = env->fpregs[src].d;
+    floatx80 result;
+    int old_flags, flags, pre;
+
+    /* Stack underflow has priority over all arithmetic operand classes. */
+    env->fpus &= ~0x0200; /* C1: no rounding up on a pre-computation fault */
+    if (env->fptags[dst] || env->fptags[src]) {
+        fpu_set_exception(env, FPUS_IE | FPUS_SF);
+        if (!(env->fpuc & FPUS_IE)) {
+            return;
+        }
+        result = floatx80_default_nan(&env->fp_status);
+    } else {
+        if (op & 1) {
+            floatx80 tmp = a;
+            a = b;
+            b = tmp;
+        }
+        old_flags = save_exception_flags(env);
+        result = floatx80_div(a, b, &env->fp_status);
+        flags = get_float_exception_flags(&env->fp_status);
+
+        /* SoftFloat can inspect both operands before selecting its result.
+         * x87 gives invalid/NaN/zero-divide precedence over denormals.
+         * In particular, denormal / zero must report #Z, not #D + #Z.
+         */
+        if (flags & float_flag_invalid) {
+            flags = float_flag_invalid;
+        } else if (floatx80_is_any_nan(a) || floatx80_is_any_nan(b)) {
+            flags = 0;
+        } else if (flags & float_flag_divbyzero) {
+            flags = float_flag_divbyzero;
+        } else {
+            /* Include x87 pseudo-denormals (explicit integer bit set). */
+            if (((a.high & 0x7fff) == 0 && a.low != 0) ||
+                ((b.high & 0x7fff) == 0 && b.low != 0)) {
+                flags |= float_flag_input_denormal_used;
+            }
+            if ((flags & float_flag_input_denormal_used) &&
+                !(env->fpuc & FPUS_DE)) {
+                /* No lower-priority post-computation flags are committed. */
+                flags = float_flag_input_denormal_used;
+            }
+        }
+        set_float_exception_flags(flags, &env->fp_status);
+        merge_exception_flags(env, old_flags);
+        pre = (flags & float_flag_invalid ? FPUS_IE : 0) |
+              (flags & float_flag_divbyzero ? FPUS_ZE : 0) |
+              (flags & float_flag_input_denormal_used ? FPUS_DE : 0);
+        if (pre & ~env->fpuc) {
+            return;
+        }
+    }
+
+    /* Commit only after the pre-computation checks; no state rollback. */
+    env->fpregs[dst].d = result;
+    env->fptags[dst] = 0;
+    if (op & 2) {
+        fpop(env);
+    }
 }
 
