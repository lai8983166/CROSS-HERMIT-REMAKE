              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 430,
          "speaker": "portrait:117",
          "text_indices": [
            22
          ],
          "text": "現在可沒有那個時間讓你好好考慮了。",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 456,
          "speaker": "portrait:101",
          "text_indices": [
            23
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 478,
          "speaker": "portrait:117",
          "text_indices": [
            24
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 506,
          "speaker": "narrator",
          "text_indices": [
            25,
            26
          ],
          "text": "那麼，法爾德閣下，\n您認為這次應該從哪裡著手呢？",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 544,
          "speaker": "portrait:117",
          "text_indices": [
            27,
            28,
            29
          ],
          "text": "一開始的時候，\n就先去一趟貝亞托利斯的湧泉谷吧。\n我們對水戰應該是沒有什麼經驗吧？",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 570,
          "speaker": "narrator",
          "text_indices": [
            30
          ],
          "text": "貝亞托利斯……",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 620,
          "speaker": "portrait:117",
          "text_indices": [
            31,
            32,
            33,
            34,
            35
          ],
          "text": "無論需要嘗試多少次，\n都要讓他們習慣在各式各樣的地形中行動。\n要讓他們瞭解「匍伏蔓延而來之物」的特性。\n不管少做了哪一樣，\n都能不能算是完整地教育了那些孩子們。",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 646,
          "speaker": "narrator",
          "text_indices": [
            36
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 684,
          "speaker": "portrait:117",
          "text_indices": [
            37,
            38,
            39
          ],
          "text": "既然我現在寄於純潔之盾籬下，\n那麼我就必須負起給予你們建議的責任。\n我可是不敢怠慢了應盡的義務。",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 710,
          "speaker": "portrait:101",
          "text_indices": [
            40
          ],
          "text": "法爾德……",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 754,
          "speaker": "portrait:117",
          "text_indices": [
            41,
            42,
            43,
            44
          ],
          "text": "……當然，\n一切的決定都在這個年輕的賢者手裡。\n我的意見是不是會被採用，\n其實對我來說，並不是很在意。",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 780,
          "speaker": "portrait:101",
          "text_indices": [
            45
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 812,
          "speaker": "portrait:117",
          "text_indices": [
            46,
            47
          ],
          "text": "那麼……\n我還有點事情要做，先失陪了。",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
              "id": 117,
              "kind": "portrait",
              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 906,
          "speaker": "portrait:101",
          "text_indices": [
            48
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 944,
          "speaker": "narrator",
          "text_indices": [
            49
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 982,
          "speaker": "portrait:101",
          "text_indices": [
            50,
            51,
            52
          ],
          "text": "都已經到了這把年紀，還是有這麼多意見。\n那一副好像要吃定你的樣子，\n真是讓我想起了過去年輕的時候。",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1008,
          "speaker": "narrator",
          "text_indices": [
            53
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1034,
          "speaker": "portrait:101",
          "text_indices": [
            54
          ],
          "text": "你能理解法爾德的這份心意嗎？",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1072,
          "speaker": "narrator",
          "text_indices": [
            55,
            56,
            57
          ],
          "text": "我能夠理解他的想法。\n……純潔之盾還是得去完成那些應該要完成的\n任務呀。",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1098,
          "speaker": "portrait:101",
          "text_indices": [
            58
          ],
          "text": "感謝你。",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1124,
          "speaker": "narrator",
          "text_indices": [
            59
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1150,
          "speaker": "portrait:101",
          "text_indices": [
            60
          ],
          "text": "……那麼，就這樣了吧。",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        },
        {
          "source_offset": 1176,
          "speaker": "narrator",
          "text_indices": [
            61
          ],
          "text": "是的……",
          "background": 6,
          "characters": [
            {
              "slot": 10,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            }
          ]
        }
      ]
    }
