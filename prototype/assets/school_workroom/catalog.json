              "asset_key": "portrait:117"
            }
          ]
        },
        {
          "source_offset": 404,
          "speaker": "portrait:101",
          "text_indices": [
            18,
            19,
            20,
            21
          ],
          "text": "你呀，從什麼時候開始，\n竟然開始模仿起帕蘭達因的行事方針了？\n要是你也遵循著聖瑟維艾斯的想法的話，\n就會知道我其實是不想太輕率地回應呀。",
          "background": 6,
          "characters": [
            {
