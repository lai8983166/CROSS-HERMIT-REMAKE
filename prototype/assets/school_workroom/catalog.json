            }
          ]
        },
        {
          "source_offset": 360,
          "speaker": "portrait:117",
          "text_indices": [
            17
          ],
          "text": "沉默就代表肯定我說的話囉。",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
            {
              "slot": 8,
