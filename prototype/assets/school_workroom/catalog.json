          "speaker": "portrait:101",
          "text_indices": [
            16
          ],
          "text": "…………",
          "background": 6,
          "characters": [
            {
              "slot": 7,
              "id": 101,
              "kind": "portrait",
              "asset_key": "portrait:101"
            },
