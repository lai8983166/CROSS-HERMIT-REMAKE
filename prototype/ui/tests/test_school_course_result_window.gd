extends "res://ui/tests/test_school_course_window.gd"

const Roles := preload("res://sim/all_result_role_replay.gd")


func _teach_and_confirm(panel) -> void:
	await _click(panel.course_button)
	await _option(panel.class_mode,1)
	await _course_row(panel.course_lists[0],2)
	await _click(panel.assign_button)
	await _click(panel.settle_button)
	await _click(panel.confirm_button)
	_check(Rect2(Vector2.ZERO,Vector2(root.size)).encloses(panel._note.get_global_rect()),"confirmed course footer fits viewport")
	_check(Rect2(Vector2.ZERO,Vector2(root.size)).encloses(panel.get_child(0).get_global_rect()),"confirmed course panel fits viewport")


func _run() -> void:
	root.size = Vector2i(1024,768)
	root.gui_embed_subwindows = true
	var main = load("res://main.tscn").instantiate()
	root.add_child(main)
	await process_frame
	main.set_physics_process(false)
	await _click(main.return_panel.start_button)
	main._physics_process(10000.0)
	await _click(main.return_panel.confirm_button)
	await _click(main.return_panel.school_button)
	var returned = main.return_demo
	var returned_before: Dictionary = returned.view().duplicate(true)
	var battle = main.battle
	var frame: int = battle.frame
	await _click(main.return_panel.new_school_button)
	var panel = main.school_panel
	var source = panel.session
	var source_before: Dictionary = source.read_snapshot()
	await _click(panel.result_button)
	_check(panel.complete_result_button.disabled and panel.result_summary.text.contains("第0周"),"source shows unavailable course result")
	await _capture("source_result_boundary")
	await _click(panel.example_button)
	await _click(panel.result_button)
	_check(panel.complete_result_button.disabled and panel.result_summary.text.contains("先安排"),"unconfirmed example cannot complete")
	await _teach_and_confirm(panel)
	await _click(panel.result_button)
	_check(not panel.complete_result_button.disabled and panel.result_summary.text.contains("已确认"),"confirmation enables result completion")
	await _capture("confirmed_pending_mvp")
	var example = panel.session
	var before: Dictionary = example.read_snapshot()
	var growth: Array = example.read_growth_records()
	var confirmation: Array = example.read_confirmation_records()
	await _click(panel.complete_result_button)
	var data: Dictionary = Roles._integers(JSON.parse_string(FileAccess.get_file_as_string("res://data/school_course_result_handoff_evidence_v1.json")))
	var native: Dictionary = data["cases"][0]
	_check(example.read_mvp_counts() == native["after_result"]["counts"],"actual input matches native MVP counts")
	_check(example.read_result_handoff()["recipient"] == native["growth_checkpoint"]["recipient"],"actual input matches native winner")
	_check(example.read_result_handoff()["adv_request"]["chapter"] == native["loads"][-1]["path"],"actual input has sourced chapter entry")
	_check(example.read_snapshot() == before and example.read_growth_records() == growth and example.read_confirmation_records() == confirmation,"completion does not repeat growth/confirmation/date")
	_check(panel.complete_result_button.disabled and panel.complete_result_button.text.contains("已记录"),"completed button cannot repeat")
	_check(panel.result_summary.text.contains("学生 #3") and panel.result_summary.text.contains("0→1"),"recipient and count visible")
	_check(panel.result_summary.text.contains("累计成长值 %d" % example.read_result_handoff()["staged_total"]),"actual comparison total visible")
	_check(panel.result_summary.text.contains("等待播放") and panel.result_summary.text.contains("日期保持4月第4周"),"pending story boundary explicit")
	_check(not example.read_result_handoff()["adv_request"]["chapter_completed"] and not example.read_result_handoff()["adv_request"]["week_advanced"],"story/week are pending")
	_check(Rect2(Vector2.ZERO,Vector2(root.size)).encloses(panel.result_summary.get_global_rect()),"result summary fits1024x768")
	_check(panel._note.get_global_rect().position.y >= panel.result_summary.get_global_rect().end.y,"result and footer do not overlap")
	await _capture("completed_mvp3")
	var journal: Array = example.journal()
	var revision: int = example.revision()
	await _click(panel.complete_result_button)
	await _key(KEY_R)
	await _key(KEY_SPACE)
	await _key(KEY_ESCAPE)
	main._physics_process(10000.0)
	_check(example.revision() == revision and example.journal() == journal,"repeat button/key does not publish")
	_check(main.battle == battle and battle.frame == frame,"school blocks battle input/ticks")
	await _click(panel.group_button)
	await _click(panel.student_buttons[0][0])
	await _click(panel.wait_student_target)
	await _click(panel.course_button)
	await _course_row(panel.course_lists[0],0)
	await _click(panel.assign_button)
	await _click(panel.result_button)
	_check(panel.complete_result_button.disabled and panel.result_summary.text.contains("学生 #3") and example.read_mvp_counts() == native["after_result"]["counts"],"later plan edit keeps frozen MVP")
	await _click(panel.source_button)
	await _click(panel.result_button)
	_check(panel.session == source and source.read_snapshot() == source_before and source.read_result_handoff().is_empty(),"source session remains separate")
	await _click(panel.example_button)
	await _click(panel.result_button)
	_check(panel.session == example and panel.complete_result_button.disabled,"example preserves completion on navigation")
	await _click(panel.close_button)
	_check(returned.view() == returned_before and main.return_panel.visible,"returned school remains separate")
	await _click(main.return_panel.new_school_button)
	_check(panel.session == example and panel.result_summary.text.contains("学生 #3"),"reopen keeps completed MVP")
	await _click(panel.restart_button)
	_check(panel.session != example and panel.session.read_result_handoff().is_empty() and panel.session.read_mvp_counts().is_empty(),"restart clears result fields")
	_check(panel.complete_result_button.disabled and source.read_snapshot() == source_before,"restart preserves source boundary")
	await _capture("restart_result")
	await _click(panel.group_button)
	await _click(panel.student_buttons[0][0])
	await _click(panel.wait_student_target)
	await _teach_and_confirm(panel)
	await _click(panel.result_button)
	await _click(panel.complete_result_button)
	_check(panel.session.read_mvp_counts() == data["cases"][1]["after_result"]["counts"],"waiting3 real input matches native MVP4 counts")
	_check(panel.result_summary.text.contains("学生 #4") and panel.result_summary.text.contains("0→1"),"waiting3 gives visible MVP4")
	_check(Rect2(Vector2.ZERO,Vector2(root.size)).encloses(panel.result_summary.get_global_rect()),"waiting result fits viewport")
	await _capture("completed_waiting3_mvp4")
	main.queue_free()
	await process_frame
	if not capture_dir.is_empty():
		var screenshots := {}
		for name in captured:
			screenshots[name+".png"] = FileAccess.get_sha256(capture_dir.path_join(name+".png"))
		var file := FileAccess.open(capture_dir.path_join("verification.json"),FileAccess.WRITE)
		file.store_string(JSON.stringify({"checks":checks,"failures":failures,"godot_version":Engine.get_version_info()["string"],"display_driver":DisplayServer.get_name(),"screenshot_sha256":screenshots,"execution_scope":"local_prototype_once_only_course_mvp_count_and_pending_adv_entry_real_input"},"  ")+"\n")
		file.close()
	print("School course result window: %d checks, %d failures" % [checks,failures.size()])
	quit(0 if failures.is_empty() else 1)
