extends "res://ui/tests/test_school_field_trial_window.gd"


func _combat_bounds(trial) -> void:
	await _field_bounds(trial)
	_check(root.get_visible_rect().encloses(trial.target_info.get_global_rect()),"combat target information fits logical viewport")
	_check(root.get_visible_rect().encloses(trial.enemy_button.get_global_rect()),"enemy focus control fits logical viewport")


func _run() -> void:
	_cleanup(); root.size = Vector2i(1024,768); root.gui_embed_subwindows = true
	if root.has_meta("school_playground_save_path"): root.remove_meta("school_playground_save_path")
	var fixture: Dictionary = Roles._integers(JSON.parse_string(FileAccess.get_file_as_string("res://data/school_playground_legacy_v3.json")))
	var file := FileAccess.open(TEST_PATH,FileAccess.WRITE)
	file.store_string(JSON.stringify(fixture["cases"][1]["save"])); file.close()
	var panel = await _new_panel()
	await _click(panel.arrival.continue_button); await _click(panel.workroom.continue_button)
	await _click(panel.story_reader.skip_button); await _dialog_click(panel.story_reader.skip_dialog.get_ok_button())
	await _click(panel.next_button)
	var state: Dictionary = panel.model.state(); var disk := FileAccess.get_sha256(TEST_PATH)
	_check(not panel.adventure_combat_button.disabled and panel.adventure_start_button.disabled,"labelled combat trial is separate from formal departure gate")
	await _preparation_bounds(panel); await _capture("combat_entry")
	await _click(panel.adventure_combat_button)
	var trial = panel.combat_trial; trial.set_process(false)
	_check(trial.visible and trial.session.units.size() == 14 and trial.session.enemies().size() == 7,"current school enters source-initial actors without deferred waves")
	_check(trial.canvas.sprites.size() == 118 and trial.member_buttons.keys() == [3,4,9],"original source sprites and current student controls loaded")
	await _combat_bounds(trial); _unchanged(panel,state,disk)
	await _capture("current_squad")
	await _click(trial.fit_button); await _capture("source_initial_scene")
	await _click(trial.enemy_button)
	var enemy_id: int = trial.inspected_id
	var enemy: Dictionary = trial.session.find_unit(enemy_id)
	_check(enemy["category"] == 5 and trial.target_info.text.contains("HP 162/162"),"enemy focus selects actual source position and health")
	await _capture("enemy_focus")
	await _map_click(trial.canvas,enemy["cell"],MOUSE_BUTTON_LEFT)
	_check(trial.session.selected_id == 3 and trial.inspected_id == enemy_id,"enemy inspection retains selected player command owner")
	await _map_click(trial.canvas,enemy["cell"],MOUSE_BUTTON_RIGHT)
	_check(trial.session.find_unit(3)["target"] == enemy_id and trial.status.text.contains("攻击指令"),"right click enemy sends owned attack rather than blocked movement")
	for index in range(600): trial.session.tick()
	trial._refresh(); await _click(trial.enemy_button)
	_check(not trial.session.events.is_empty() and enemy["limits"]["hp"] < 162,"actual command moves into range and releases damage")
	_check(trial.target_info.text.contains("HP") and trial.member_buttons[3].text.contains("MP 445/445"),"live combat health feedback and unchanged basic attack MP")
	await _capture("attack_and_health")
	await _key(KEY_SPACE)
	var frame: int = trial.session.frame; var units: Array = trial.session.read_units()
	trial._process(10.0)
	_check(trial.session.paused and trial.session.frame == frame and trial.session.read_units() == units,"pause holds all actors and pending attack phases")
	await _capture("combat_paused")
	await _click(trial.stop_button)
	_check(trial.session.find_unit(3)["target"] == -1 and not trial.session.phases.has(3),"stop cancels owned attack while paused")
	await _click(trial.pause_button)
	await _click(trial.enemy_button)
	var destination := Vector2i(-1,-1)
	for y in range(-3,4):
		for x in range(-3,4):
			var cell: Vector2i = enemy["cell"]+Vector2i(x,y)
			if trial.session.walkable(cell) and not trial.session._blocked(3).has(cell): destination = cell; break
		if destination.x >= 0: break
	_check(destination.x >= 0,"source opponent has a reachable nearby firing cell")
	await _map_click(trial.canvas,destination,MOUSE_BUTTON_RIGHT)
	for index in range(500): trial.session.tick()
	trial._refresh(); await _click(trial.enemy_button)
	_check(trial.session.find_unit(3)["limits"]["hp"] < 117,"moving into source opponent range permits trial retaliation")
	await _capture("enemy_retaliation")
	await _click(trial.enemy_button)
	await _map_click(trial.canvas,enemy["cell"],MOUSE_BUTTON_RIGHT)
	for index in range(1100): trial.session.tick()
	trial._refresh()
	_check(enemy["limits"]["hp"] == 0 and trial.session.enemies().size() == 6,"attack clears one source opponent without enabling deferred waves")
	await _capture("enemy_cleared")
	for window in [Vector2i(1280,800),Vector2i(800,600)]:
		root.size = window; await _combat_bounds(trial); await _click(trial.center_button)
		await _capture("combat_%d" % window.x); _unchanged(panel,state,disk)
	root.size = Vector2i(1024,768)
	await _key(KEY_ESCAPE)
	_check(not trial.visible and trial.session.units.is_empty(),"Escape discards temporary health and returns school")
	_unchanged(panel,state,disk); await _capture("combat_returned")
	await _click(panel.adventure_combat_button)
	_check(trial.session.enemies().size() == 7 and trial.session.find_unit(3)["limits"]["hp"] == 117,"reopen restores source actors and current saved school health")
	trial.set_process(true); await create_timer(0.15).timeout; trial.set_process(false)
	_check(trial.session.frame > 0,"real viewport processing advances isolated combat")
	await _click(trial.close_button)
	await _click(panel.next_button); await _click(panel.student_buttons[0][2]); await _click(panel.wait_target)
	await _click(panel.next_button)
	state = panel.model.state(); disk = FileAccess.get_sha256(TEST_PATH)
	await _click(panel.adventure_combat_button)
	_check(trial.member_buttons.keys() == [3,4] and trial.session.units.size() == 13,"waiting edit removes current student while retaining exact source scene actors")
	await _combat_bounds(trial); await _capture("edited_combat_squad"); _unchanged(panel,state,disk)
	var before: Array = trial.session.read_units()
	_check(not trial.open_trial({},panel.adventure_limits,{}) and trial.session.read_units() == before,"invalid reopen preserves current owned combat")
	await _click(trial.close_button)
	await _click(panel.adventure_trial_button)
	_check(panel.field_trial.visible and panel.field_trial.session.units.size() == 2,"previous movement trial remains a separate current-squad mode")
	await _click(panel.field_trial.close_button)
	await _click(panel.adventure_map_button); await _click(panel.map_preview.dialogue_button)
	_check(panel.map_preview.dialogue_panel.visible,"original graphical opening remains accessible after combat")
	await _key(KEY_ESCAPE); await _key(KEY_ESCAPE); _unchanged(panel,state,disk)
	var entry: Dictionary = panel.model._school_entry.duplicate(true)
	panel.model._school_entry["after"]["participants"][0]["equipped_items"][0] = 1
	panel.refresh()
	_check(panel.adventure_combat_button.disabled and not trial.open_trial(panel.model.adventure_preparation(),panel.model.adventure_combat_limits(),{}),"unsupported current equipment refuses combat without fallback")
	panel.model._school_entry = entry; panel.refresh()
	await _click(panel.next_button); await _click(panel.teacher_buttons[0]); await _click(panel.wait_target)
	await _click(panel.next_button)
	_check(panel.adventure_combat_button.disabled and panel.adventure_start_button.disabled,"unready plan and formal adventure remain gated")
	panel.queue_free(); await process_frame; _cleanup(); _finish()
