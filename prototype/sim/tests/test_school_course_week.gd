extends "res://sim/tests/test_base.gd"
const Plans := preload("res://sim/tests/test_school_return_planning.gd")
const Model := preload("res://sim/school_playground.gd")


func test_choose_teach_read_story_replan_and_load_file() -> void:
	var ui=Plans.UIHelpers.new()._school_ui()
	assert_true(ui.model.restore(Plans.new()._returned().export_save())["supported"])
	ui.refresh()
	var panel=ui.postbattle_panel
	panel.find_child("plan_start",true,false).pressed.emit()
	# A previously selected adventure stays available when the class studies.
	panel.find_child("adventure_8",true,false).pressed.emit()
	panel.find_child("mode_0_1",true,false).pressed.emit()
	var courses=panel.find_child("courses_0",true,false)
	courses.item_selected.emit(courses.get_item_index(3))
	panel.find_child("settle",true,false).pressed.emit()
	panel.commit_dialog.hide()
	panel.commit_dialog.confirmed.emit()
	assert_eq(ui.model.stage(),"course_result")
	var saved_result: Dictionary=ui.model.export_save()
	assert_eq(saved_result["version"],6)
	var course: Dictionary=ui.model.read_postbattle()
	assert_true(ui.model.restore_text(JSON.stringify(saved_result))["supported"])
	ui.refresh()
	panel.find_child("continue_course_story",true,false).pressed.emit()
	assert_eq(ui.model.export_save()["version"],8)
	assert_eq(ui.model.read_postbattle()["page"]["chapter"],23)
	assert_true(panel.heading.text.contains("课后剧情"))
	assert_false(ui.model.execute({"op":"course_story"})["supported"])
	panel.next.pressed.emit()
	var reading: Dictionary=ui.model.export_save()
	assert_true(ui.model.restore(reading)["supported"])
	assert_eq(ui.model.read_postbattle()["cursor"],1)
	panel.skip_dialog.confirmed.emit()
	assert_eq(ui.model.read_postbattle()["page"]["chapter"],24)
	panel.skip_dialog.confirmed.emit()
	panel.next.pressed.emit()
	assert_eq(ui.model.stage(),"returned_school")
	var week: Dictionary=ui.model.read_postbattle()
	assert_eq([week["bundle"]["school"]["month"],week["bundle"]["school"]["week"]],[5,2])
	assert_eq(week["planning"],course["planning"])
	assert_eq(week["planning"]["ledger"]["entries"].map(func(r):return r["elapsed"]),[1,3])
	assert_eq(week["bundle"]["counts"],course["bundle"]["counts"])
	assert_eq(week["bundle"]["records"],course["bundle"]["records"])
	assert_eq(week["bundle"]["school"]["global_total_511c"],course["bundle"]["school"]["global_total_511c"])
	for row in course["bundle"]["growth"]:
		var current=week["bundle"]["growth"].filter(func(r):return r["character_id"]==row["character_id"])[0]
		for key in ["attributes","level_50","growth_pools","skill_statuses"]: assert_eq(current[key],row[key])
	assert_true(panel.find_child("adventure_8",true,false).button_pressed)
	assert_true(panel.find_child("adventure_17",true,false)!=null)
	panel.find_child("mode_0_1",true,false).pressed.emit()
	courses=panel.find_child("courses_0",true,false)
	courses.item_selected.emit(courses.get_item_index(4))
	assert_eq(ui.model.export_save()["commands"][-1],{"op":"return_course","group":0,"course":4})
	var path := "user://course-week-%d.json" % Time.get_ticks_usec()
	assert_true(ui.model.save_file(path)["supported"])
	var loaded := Model.new()
	assert_true(loaded.load_file(path)["supported"])
	assert_eq(loaded.state(),ui.model.state())
	assert_eq(loaded.export_save(),ui.model.export_save())
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	for op in ["course_story","post_skip"]:
		assert_false(loaded.execute({"op":op})["supported"])
	var bad := reading.duplicate(true)
	for key in ["version","context","rules"]:bad[key]=saved_result[key]
	assert_false(loaded.restore(bad)["supported"])
	assert_eq(loaded.export_save(),ui.model.export_save())
	ui.free()


func test_course_without_selected_adventure_requires_course_ledger() -> void:
	var helpers=load("res://sim/tests/test_school_return_courses.gd").new()
	var planned: Dictionary=helpers._planned(10)
	var calendar=Model.Postbattle.SortieWeek
	var adventures=Model.Postbattle.Adventures
	assert_false(calendar.next_week(planned)["supported"])
	var settled := Model.Postbattle.Courses.settle(planned)
	assert_true(settled["supported"])
	var advanced: Dictionary=calendar.next_week(settled["after"])
	assert_true(advanced["supported"])
	assert_false(calendar.next_week(advanced["after"])["supported"])
	var room: Dictionary=calendar.finish_story(advanced["after"])
	var initial: Dictionary=adventures.initial()
	assert_false(calendar.school_return(room["after"],initial)["supported"])
	assert_false(calendar.school_return(room["after"],adventures.advance(initial,8))["supported"])
	var aged: Dictionary=adventures.advance(initial,0)
	var opened: Dictionary=calendar.school_return(room["after"],aged)
	assert_true(opened["supported"])
	assert_eq(opened["ledger_after"],aged)
	assert_eq(opened["after"]["school"]["lecture_active"],0)
	assert_eq(opened["after"]["counts"],settled["after"]["counts"])
