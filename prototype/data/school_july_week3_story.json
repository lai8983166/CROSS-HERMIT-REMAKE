          "speaker": "帕彌菈",
          "text_indices": [
            72
          ],
          "text": "是的！！"
        },
        {
          "chapter": 209,
          "source_offset": 2056,
          "speaker_id": 8,
          "speaker": "奎絲忒",
          "text_indices": [
            73
          ],
