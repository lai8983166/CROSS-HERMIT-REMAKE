          "source_offset": 1838,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            68
          ],
          "text": "是的！！"
        },
        {
          "chapter": 209,
          "source_offset": 1900,
          "speaker_id": 2,
          "speaker": "夏朧",
          "text_indices": [
            69
          ],
