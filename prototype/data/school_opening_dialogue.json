    {
      "text_index": 0,
      "text": "瑟希莉絲、伊里安。"
    },
    {
      "text_index": 1,
      "text": "再跟你們確認一次這次的作戰目的。"
    },
    {
      "text_index": 2,
      "text": "要找出那些已經失去蒼藍光輝的聖者之泉。"
    },
    {
      "text_index": 3,
      "text": "…………"
    },
    {
      "text_index": 4,
      "text": "利用這裡的地形，"
    },
    {
      "text_index": 5,
      "text": "如果能夠殲滅「匍伏蔓延而來之物」的話，"
    },
    {
      "text_index": 6,
      "text": "當然是最好的。"
    },
    {
      "text_index": 7,
      "text": "…………"
    },
    {
      "text_index": 8,
      "text": "很好。"
    },
    {
      "text_index": 9,
      "text": "那麼，就開始吧。"
    }
  ]
}
