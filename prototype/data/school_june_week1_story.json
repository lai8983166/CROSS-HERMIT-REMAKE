{
  "schema_version": 1,
  "source_image_sha256": "588b4288e4c737dc489d2b9bc0652cca85e3d668b1784942ef4b4bda916f1005",
  "scenes": [
    {
      "chapter": 32,
      "source": "ADV/DAT/CHAPTER032.YBC",
      "sha256": "a54f465768fdbe70048c21e3daab7cd06c558a99eea4ba953bf68d6ca5192239",
      "text_count": 85,
      "pages": [
        {
          "chapter": 32,
          "source_offset": 114,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            0
          ],
          "text": "萬物都染上了黃昏的顏色。"
        },
        {
          "chapter": 32,
          "source_offset": 142,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            1,
            2
          ],
          "text": "雖然即將到來的是漆黑的闇影，\n但此刻卻如斯耀眼。"
        },
        {
          "chapter": 32,
          "source_offset": 192,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            3
          ],
          "text": "妳這樣……會著涼的。"
        },
        {
          "chapter": 32,
          "source_offset": 226,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            4
          ],
          "text": "法娜……"
        },
        {
          "chapter": 32,
          "source_offset": 252,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            5
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 278,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            6
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 312,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            7
          ],
          "text": "以前的日子還真是快樂呀。"
        },
        {
          "chapter": 32,
          "source_offset": 346,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            8
          ],
          "text": "嗯嗯。"
        },
        {
          "chapter": 32,
          "source_offset": 368,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            9
          ],
          "text": "以贏得王杯為目標而揮劍的日子……"
        },
        {
          "chapter": 32,
          "source_offset": 390,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            10
          ],
          "text": "而妳當時正努力地在修練光的魔法……"
        },
        {
          "chapter": 32,
          "source_offset": 424,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            11
          ],
          "text": "出外旅行、互相磨礪劍術。"
        },
        {
          "chapter": 32,
          "source_offset": 452,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            12,
            13
          ],
          "text": "發現賢者們的鬍髭沾上了牛奶的時候，\n還真是讓人忍不住笑出來呢。"
        },
        {
          "chapter": 32,
          "source_offset": 486,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            14
          ],
          "text": "呵，那倒是真的呢。"
        },
        {
          "chapter": 32,
          "source_offset": 520,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            15
          ],
          "text": "……第一次看到艾爾雪這個樣子呢。"
        },
        {
          "chapter": 32,
          "source_offset": 554,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            16
          ],
          "text": "？"
        },
        {
          "chapter": 32,
          "source_offset": 594,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            17,
            18
          ],
          "text": "常常說著：「只要有我這把劍在的話，\n就不需要學什麼咒文啦。」"
        },
        {
          "chapter": 32,
          "source_offset": 616,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            19
          ],
          "text": "一直都是很有活力的樣子。"
        },
        {
          "chapter": 32,
          "source_offset": 644,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            20,
            21
          ],
          "text": "能讓奈比洛斯閣下氣到臉都僵硬了的，\n空前絕後的，就只有妳一個了呢。"
        },
        {
          "chapter": 32,
          "source_offset": 678,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            22
          ],
          "text": "呵呵，這種事情我可是不記得了。"
        },
        {
          "chapter": 32,
          "source_offset": 712,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            23
          ],
          "text": "真的……"
        },
        {
          "chapter": 32,
          "source_offset": 734,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            24
          ],
          "text": "就算只有今天晚上也好……"
        },
        {
          "chapter": 32,
          "source_offset": 756,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            25
          ],
          "text": "真想回到那段時光呀。"
        },
        {
          "chapter": 32,
          "source_offset": 796,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            26,
            27
          ],
          "text": "想不到法娜‧修貝流士也會說出這麼喪氣的話\n呀。"
        },
        {
          "chapter": 32,
          "source_offset": 822,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            28
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 856,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            29
          ],
          "text": "當然是要讓所有的事物都回復到像過去那樣，"
        },
        {
          "chapter": 32,
          "source_offset": 878,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            30
          ],
          "text": "用我們的力量。"
        },
        {
          "chapter": 32,
          "source_offset": 912,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            31
          ],
          "text": "艾爾雪。"
        },
        {
          "chapter": 32,
          "source_offset": 946,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            32
          ],
          "text": "現在……"
        },
        {
          "chapter": 32,
          "source_offset": 972,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            33
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1006,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            34
          ],
          "text": "現在的生活並不讓人開心……"
        },
        {
          "chapter": 32,
          "source_offset": 1028,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            35
          ],
          "text": "不能像那個時候一樣，想幹什麼就幹什麼。"
        },
        {
          "chapter": 32,
          "source_offset": 1056,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            36,
            37
          ],
          "text": "不過呢，在這裡也可以體驗一些誰都沒有嘗試\n過的冒險。"
        },
        {
          "chapter": 32,
          "source_offset": 1090,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            38
          ],
          "text": "嗯……"
        },
        {
          "chapter": 32,
          "source_offset": 1112,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            39
          ],
          "text": "艾爾雪呀，我覺得呢……"
        },
        {
          "chapter": 32,
          "source_offset": 1140,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            40,
            41
          ],
          "text": "無論是完成了多麼偉大的功績，\n那都沒有什麼了不起。"
        },
        {
          "chapter": 32,
          "source_offset": 1166,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            42
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1210,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            43,
            44,
            45,
            46
          ],
          "text": "真正有意義的，\n是瞭解了事情會變得非常危險的時候，\n明明知道要捨棄一切，\n但仍然投身於冒險之中。"
        },
        {
          "chapter": 32,
          "source_offset": 1232,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            47
          ],
          "text": "我覺得這才是真正了不起的事情。"
        },
        {
          "chapter": 32,
          "source_offset": 1266,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            48
          ],
          "text": "我一直很嚮往能夠做這樣的事情。"
        },
        {
          "chapter": 32,
          "source_offset": 1292,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            49
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1326,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            50
          ],
          "text": "雖然如此，我所能感覺到的……"
        },
        {
          "chapter": 32,
          "source_offset": 1354,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            51,
            52
          ],
          "text": "卻總是……就算有機會，\n也不敢去好好掌握的自己。"
        },
        {
          "chapter": 32,
          "source_offset": 1388,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            53
          ],
          "text": "艾爾雪……"
        },
        {
          "chapter": 32,
          "source_offset": 1428,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            54,
            55
          ],
          "text": "捨棄一切自己珍視的東西，\n然後展開旅行，像這樣的事情……"
        },
        {
          "chapter": 32,
          "source_offset": 1450,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            56
          ],
          "text": "我一定做不到吧，這我一直都很清楚。"
        },
        {
          "chapter": 32,
          "source_offset": 1476,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            57
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1516,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            58,
            59
          ],
          "text": "但是，來到了愛爾梅納斯以後，\n我想我稍微有一點改變了。"
        },
        {
          "chapter": 32,
          "source_offset": 1544,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            60,
            61
          ],
          "text": "所謂的冒險呀，\n並不只是捨棄某些東西而已。"
        },
        {
          "chapter": 32,
          "source_offset": 1570,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            62
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1602,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            63,
            64
          ],
          "text": "冒險中也會有必須守護的珍貴事物，\n值得我們去奮鬥的時候。"
        },
        {
          "chapter": 32,
          "source_offset": 1636,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            65
          ],
          "text": "為了某些重要的事物，是吧？"
        },
        {
          "chapter": 32,
          "source_offset": 1670,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            66
          ],
          "text": "嗯嗯。"
        },
        {
          "chapter": 32,
          "source_offset": 1698,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            67,
            68
          ],
          "text": "而且，教我這項道理的人，\n就是妳呀，法娜。"
        },
        {
          "chapter": 32,
          "source_offset": 1724,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            69
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1750,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            70
          ],
          "text": "…………"
        },
        {
          "chapter": 32,
          "source_offset": 1784,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            71
          ],
          "text": "……那麼，艾爾雪是為了什麼而努力的呢？"
        },
        {
          "chapter": 32,
          "source_offset": 1818,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            72
          ],
          "text": "我才想問妳這個問題呢。"
        },
        {
          "chapter": 32,
          "source_offset": 1852,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            73
          ],
          "text": "……嘿。"
        },
        {
          "chapter": 32,
          "source_offset": 1886,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            74
          ],
          "text": "……呵呵。"
        },
        {
          "chapter": 32,
          "source_offset": 1920,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            75
          ],
          "text": "我瞭解啦，這是秘密，秘密～"
        },
        {
          "chapter": 32,
          "source_offset": 1942,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            76
          ],
          "text": "現在還不是說出來的時候。"
        },
        {
          "chapter": 32,
          "source_offset": 1976,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            77
          ],
          "text": "嗯嗯，是呀。"
        },
        {
          "chapter": 32,
          "source_offset": 1998,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            78
          ],
          "text": "現在還不是說出來的時候。"
        },
        {
          "chapter": 32,
          "source_offset": 2038,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            79,
            80
          ],
          "text": "…………\n那～麼。"
        },
        {
          "chapter": 32,
          "source_offset": 2060,
          "speaker_id": 5,
          "speaker": "法娜",
          "text_indices": [
            81
          ],
          "text": "要好好地努力下去嗎，艾爾雪‧貝爾薩？"
        },
        {
          "chapter": 32,
          "source_offset": 2094,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            82
          ],
          "text": "當然啦，法娜‧修貝流士。"
        },
        {
          "chapter": 32,
          "source_offset": 2116,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            83
          ],
          "text": "加油吧。"
        },
        {
          "chapter": 32,
          "source_offset": 2138,
          "speaker_id": 6,
          "speaker": "艾爾雪",
          "text_indices": [
            84
          ],
          "text": "我們一起加油吧。"
        }
      ],
      "effects": []
    },
    {
      "chapter": 33,
      "source": "ADV/DAT/CHAPTER033.YBC",
      "sha256": "11d4fa2010e7c592a56a20c2f8ebc68e2ce2d943bbedb338d2eb84c753c59ada",
      "text_count": 83,
      "pages": [
        {
          "chapter": 33,
          "source_offset": 214,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            0
          ],
          "text": "這裡是～！！！"
        },
        {
          "chapter": 33,
          "source_offset": 242,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            1,
            2
          ],
          "text": "太好啦～～～\n這裡有書桌耶～～～"
        },
        {
          "chapter": 33,
          "source_offset": 264,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            3
          ],
          "text": "而且連椅子也有呢！！"
        },
        {
          "chapter": 33,
          "source_offset": 290,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            4
          ],
          "text": "哈～～～～～"
        },
        {
          "chapter": 33,
          "source_offset": 312,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            5
          ],
          "text": "這種感覺是什麼呀，這種懷念的感覺。"
        },
        {
          "chapter": 33,
          "source_offset": 340,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            6,
            7
          ],
          "text": "給人一種……\n不知道什麼時候曾經來過這裡的感覺呢……"
        },
        {
          "chapter": 33,
          "source_offset": 372,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            8,
            9
          ],
          "text": "雖然有一大堆又厚又重的書，\n看起來好像永遠也看不完的樣子……"
        },
        {
          "chapter": 33,
          "source_offset": 394,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            10
          ],
          "text": "嗯，這個是……"
        },
        {
          "chapter": 33,
          "source_offset": 416,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            11
          ],
          "text": "呵呵～這個我看得懂唷。"
        },
        {
          "chapter": 33,
          "source_offset": 438,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            12
          ],
          "text": "什麼什麼……"
        },
        {
          "chapter": 33,
          "source_offset": 470,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            13,
            14
          ],
          "text": "帕彌菈也是，\n不知不覺間變得很成熟了。"
        },
        {
          "chapter": 33,
          "source_offset": 498,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            15,
            16
          ],
          "text": "瑟希莉絲，\n純粹的思維結晶。"
        },
        {
          "chapter": 33,
          "source_offset": 542,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            17,
            18,
            19,
            20
          ],
          "text": "法娜，\n個人觀感明顯，總是保持率直的微笑，\n雖然在苦難之中也能筆直地走出自己的路，\n英姿凜凜的公主。"
        },
        {
          "chapter": 33,
          "source_offset": 574,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            21,
            22
          ],
          "text": "艾爾雪，\n以道義為信念，堅定地生活著。"
        },
        {
          "chapter": 33,
          "source_offset": 602,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            23,
            24
          ],
          "text": "伊里安，\n努力地想要變得更率直，正在改頭換面中。"
        },
        {
          "chapter": 33,
          "source_offset": 634,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            25,
            26
          ],
          "text": "奎絲忒，\n沉默地編織自己的夢想，可愛的精靈。"
        },
        {
          "chapter": 33,
          "source_offset": 656,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            27
          ],
          "text": "總有一天，大家都會走上各自的道路吧……"
        },
        {
          "chapter": 33,
          "source_offset": 682,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            28
          ],
          "text": "嗯～～～～！"
        },
        {
          "chapter": 33,
          "source_offset": 704,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            29
          ],
          "text": "寫得真是莫名其妙～討厭！！"
        },
        {
          "chapter": 33,
          "source_offset": 732,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            30,
            31
          ],
          "text": "要寫日記的話就給我寫得像日記一點啊，\n要給我寫得清清楚楚的，清清楚楚的！！"
        },
        {
          "chapter": 33,
          "source_offset": 770,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            32
          ],
          "text": "《……？》"
        },
        {
          "chapter": 33,
          "source_offset": 804,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            33
          ],
          "text": "我想想，這個人應該是這裡的老師吧！"
        },
        {
          "chapter": 33,
          "source_offset": 832,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            34,
            35
          ],
          "text": "不過，本來以為是小孩的這個帕彌菈，\n還真是讓人蠻感興趣的呢～～！"
        },
        {
          "chapter": 33,
          "source_offset": 858,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            36
          ],
          "text": "看來妳看得很高興嘛？"
        },
        {
          "chapter": 33,
          "source_offset": 892,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            37
          ],
          "text": "是啊是啊，要是內容更多一點就好了……"
        },
        {
          "chapter": 33,
          "source_offset": 914,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            38
          ],
          "text": "唉呀啊啊啊啊啊！！！"
        },
        {
          "chapter": 33,
          "source_offset": 942,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            39,
            40
          ],
          "text": "欸嘿嘿，其實也不是很討厭啦，\n像這樣的……日記？"
        },
        {
          "chapter": 33,
          "source_offset": 968,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            41
          ],
          "text": "承蒙指教了。"
        },
        {
          "chapter": 33,
          "source_offset": 994,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            42
          ],
          "text": "…………"
        },
        {
          "chapter": 33,
          "source_offset": 1020,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            43
          ],
          "text": "妳是？"
        },
        {
          "chapter": 33,
          "source_offset": 1054,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            44
          ],
          "text": "凱洛特！！"
        },
        {
          "chapter": 33,
          "source_offset": 1076,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            45
          ],
          "text": "凱洛特‧溫菲！"
        },
        {
          "chapter": 33,
          "source_offset": 1098,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            46
          ],
          "text": "那你呢！？"
        },
        {
          "chapter": 33,
          "source_offset": 1130,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            47,
            48
          ],
          "text": "…………\n我啊，是這個房間的主人。"
        },
        {
          "chapter": 33,
          "source_offset": 1164,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            49
          ],
          "text": "老師？"
        },
        {
          "chapter": 33,
          "source_offset": 1190,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            50
          ],
          "text": "歡迎妳來到純潔之盾伊諾森提雅。"
        },
        {
          "chapter": 33,
          "source_offset": 1230,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            51,
            52
          ],
          "text": "住的房子很小，\n可是你為人度量倒是蠻大的呢……！"
        },
        {
          "chapter": 33,
          "source_offset": 1256,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            53
          ],
          "text": "謝謝。"
        },
        {
          "chapter": 33,
          "source_offset": 1296,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            54,
            55
          ],
          "text": "可是可是，我還真不知道……\n原來愛爾梅納斯是這麼危險的地方呢。"
        },
        {
          "chapter": 33,
          "source_offset": 1322,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            56
          ],
          "text": "…………"
        },
        {
          "chapter": 33,
          "source_offset": 1360,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            57,
            58,
            59
          ],
          "text": "每天都在這裡過著這麼可怕的生活，\n那我就可以變成了不起的賢者了，\n對吧～～～"
        },
        {
          "chapter": 33,
          "source_offset": 1386,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            60
          ],
          "text": "…………"
        },
        {
          "chapter": 33,
          "source_offset": 1420,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            61
          ],
          "text": "你要相信我嘛～"
        },
        {
          "chapter": 33,
          "source_offset": 1442,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            62
          ],
          "text": "倒是，這裡看起來有一些不平凡的孩子呢。"
        },
        {
          "chapter": 33,
          "source_offset": 1464,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            63
          ],
          "text": "那應該有年輕的女孩在這裡吧？"
        },
        {
          "chapter": 33,
          "source_offset": 1492,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            64,
            65
          ],
          "text": "是跟我差不多大的嗎？\n還是比我小一點呢……"
        },
        {
          "chapter": 33,
          "source_offset": 1524,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            66,
            67
          ],
          "text": "雖然這裡風景很漂亮，\n不過也有很多黑影在四周晃來晃去呢！！"
        },
        {
          "chapter": 33,
          "source_offset": 1546,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            68
          ],
          "text": "嗯～～～真不愧是愛爾梅納斯！"
        },
        {
          "chapter": 33,
          "source_offset": 1572,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            69
          ],
          "text": "黑影……？"
        },
        {
          "chapter": 33,
          "source_offset": 1606,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            70
          ],
          "text": "是的！！"
        },
        {
          "chapter": 33,
          "source_offset": 1638,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            71,
            72
          ],
          "text": "《匍伏蔓延而來之物……？\n　這位少女有碰到過？》"
        },
        {
          "chapter": 33,
          "source_offset": 1672,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            73
          ],
          "text": "……這裡就是伊諾森提雅，對吧？"
        },
        {
          "chapter": 33,
          "source_offset": 1698,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            74
          ],
          "text": "嗯嗯。"
        },
        {
          "chapter": 33,
          "source_offset": 1732,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            75
          ],
          "text": "……原來如此啊。"
        },
        {
          "chapter": 33,
          "source_offset": 1754,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            76
          ],
          "text": "那這裡就是爺爺的故鄉囉～"
        },
        {
          "chapter": 33,
          "source_offset": 1792,
          "speaker_id": 268435455,
          "speaker": "老师",
          "text_indices": [
            77,
            78,
            79
          ],
          "text": "…………\n凱洛特啊，如果妳願意的話，\n可不可以把剛剛說的話再說詳細一點？"
        },
        {
          "chapter": 33,
          "source_offset": 1826,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            80
          ],
          "text": "嗯！"
        },
        {
          "chapter": 33,
          "source_offset": 1854,
          "speaker_id": 1,
          "speaker": "凱洛特",
          "text_indices": [
            81,
            82
          ],
          "text": "如果你可以讓我參加考試的話！\n我什麼都會說唷！"
        }
      ],
