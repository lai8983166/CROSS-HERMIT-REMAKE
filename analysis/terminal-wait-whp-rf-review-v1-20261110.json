  "guest_bytes": {
    "gdt_at_6008": "ffff0000009bcf00ffff00000093cf00",
    "idt_vector1_at_6808": "00400800008e0000",
    "handler_at_4000": "60ff83040200000f21f08983080200008b44242089830c0200008b442428898310020000814c24280000010061cf",
    "handler_semantics": "PUSHAD preserves GPRs; increments [EBX+204]; MOV EAX,DR6; saves DR6, frame EIP at ESP+20 and frame EFLAGS at ESP+28; ORs original frame RF bit; POPAD; IRETD. Thus frame flags=46 precedes the handler RF modification, not the IRETD return flags.",
    "iret_tail": "589c810c24000001000e50cf",
    "iret_semantics": "POP original return target; PUSHFD; set RF in saved stack image; PUSH CS; PUSH target; IRETD. PUSHFD alone is not a measurement of live RF.",
    "marker_order": [
      "consumer",
      "debug_handler",
      "handler_dr6",
      "handler_eip",
      "handler_stacked_flags"
    ]
  },
